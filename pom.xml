<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>backend-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>backend-app</name>
    <description>Java Backend App</description>

    <packaging>jar</packaging>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ⭐ Nexus Deployment -->
    <distributionManagement>

        <snapshotRepository>
            <id>nexus</id>
            <url>http://192.168.0.50:9090/repository/maven_snapshots/</url>
        </snapshotRepository>

        <repository>
            <id>nexus</id>
            <url>http://192.168.0.50:9090/repository/maven_releases/</url>
        </repository>

    </distributionManagement>

    <build>
        <plugins>

            <!-- Spring Boot Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Maven Deploy Plugin (important for CI/CD stability) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.1</version>
            </plugin>

        </plugins>
    </build>
     <distributionManagement>
    
    <!-- For release versions -->
    <repository>
        <id>nexus</id>
        <url>http://192.168.0.50:9090/repository/maven_releases/</url>
    </repository>

    <!-- For snapshot versions -->
    <snapshotRepository>
        <id>nexus</id>
        <url>http://192.168.0.50:9090/repository/maven-snapshots/</url>
    </snapshotRepository>

</distributionManagement>
</project>
