<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>demo</artifactId>

    <!-- ✔ KEEP SNAPSHOT for CI/CD -->
    <version>0.0.1-SNAPSHOT</version>

    <name>backend-app</name>
    <description>Java Backend App</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ⭐ IMPORTANT: Nexus deployment config -->
    <distributionManagement>

        <!-- SNAPSHOT repo -->
        <snapshotRepository>
            <id>nexus</id>
            <url>http://192.168.0.50:9090/repository/maven_snapshots/</url>
        </snapshotRepository>

        <!-- RELEASE repo -->
        <repository>
            <id>nexus</id>
            <url>http://192.168.0.50:9090/repository/maven_releases/</url>
        </repository>

    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
